pkgbase = phasex64
	pkgdesc = ALSA driver and control panel for the TerraTec/TerraSoniq PHASE X64 USB
	pkgver = 0.9.1
	pkgrel = 1
	url = https://github.com/flarkflarkflark/phasex64-linux
	arch = any
	license = GPL-2.0-only
	makedepends = gettext
	makedepends = librsvg
	source = https://github.com/flarkflarkflark/phasex64-linux/releases/download/v0.9.1/phasex64-linux-0.9.1.tar.gz
	sha256sums = 945d8003bbd399cc854d41c1079debcbe3938ff39b6f5611f2f6bc867fbf11bb

pkgname = snd-usb-phasex64-dkms
	pkgdesc = ALSA driver for the TerraTec/TerraSoniq PHASE X64 USB (DKMS)
	depends = dkms

pkgname = phasex64-panel
	pkgdesc = Control panel for the TerraTec/TerraSoniq PHASE X64 USB
	depends = python
	depends = tk
	depends = alsa-utils
	depends = hicolor-icon-theme
	depends = gtk-update-icon-cache
	optdepends = pipewire: BUFFER control (pw-metadata, pw-top)
	optdepends = snd-usb-phasex64-dkms: the driver this panel controls

pkgname = phasex64-wireplumber
	pkgdesc = WirePlumber Pro Audio profile/rate/format pins for the PHASE X64 USB (optional)
	depends = wireplumber
