# `setpriv --pdeathsig TERM -- <cmd>` execs <cmd> directly (same PID, same
# for stdbuf's own exec of its target right after) - so wrapping a child
# command with this sets PR_SET_PDEATHSIG on the real aseqdump/alsactl
# process itself, which the kernel delivers the moment the THREAD that
# spawned it exits (not merely when the process does). Both call sites
# that use this (Mixer.start_change_monitor(), MidiMonitor.ensure()) are
# only ever invoked from PanelIO's own worker thread, which lives as long
# as the panel does (see PanelIO.run()'s "state"/"midi_start" handlers) -
# moving either spawn onto a short-lived thread would silently defeat
# this, so don't.
_SETPRIV = shutil.which("setpriv")
_pdeathsig_warned = False


def _with_pdeathsig(cmd):
    """Wrap cmd so it's killed if the panel is, even via SIGKILL - falls
    back to the plain command (reaped only via the panel's own close()/
    signal-handler path, as before this existed) if setpriv isn't
    installed, logging that fact once, at debug level.
    """
    global _pdeathsig_warned
    if _SETPRIV is None:
        if not _pdeathsig_warned:
            _pdeathsig_warned = True
            _LOG.debug("setpriv not found; %s won't have PDEATHSIG set", cmd[0])
        return cmd
    return [_SETPRIV, "--pdeathsig", "TERM", "--"] + cmd

