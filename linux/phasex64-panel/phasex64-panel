        self.status = tk.Label(self.root, bg="#101316", fg=DIM_TEXT, anchor="w",
                               padx=22, pady=12, font=("DejaVu Sans Mono", 9), justify="left")
        self.status.pack(fill="x")
        # Deliberately NOT wraplength-bound, unlike hint/notice above: this
        # is meant to read as one compact status line, not wrapped prose -
        # found wrapping onto a second line on real hardware, 2026-10-16
        # (a monospace font and the full five-field text are both wider
