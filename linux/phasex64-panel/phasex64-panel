    def click(self, num):
        if num == BTN_CLOSE:
            self.close()
            return
        if num == BTN_INFO:
            self.about()
            return
        if num in ENUM_BUTTONS:
            name, item = ENUM_BUTTONS[num]
            index = ADC_SOURCE_ITEMS[name].index(item)
            self.write([(name, str(index))])
            return
        name = SWITCH_BUTTONS.get(num)
        if not name:
            return
        self.write([(name, "off" if self.state.get(name) else "on")])

    def info(self):
        vals = self.values
        if CLOCK not in vals:
            self.notice.configure(text=_("Clock control unavailable"), fg=MUTED)
            return
        internal = vals.get(CLOCK, "0") == "0"
        locked = vals.get(LOCK) == "on"
        msg = _("Clock source: {current}\nDigital input: {input_state}\n\n"
                "Switch clock source to {target}?").format(
            current=_("internal") if internal else _("digital input"),
            input_state=_("locked") if locked else _("no signal"),
            target=_("digital input") if internal else _("internal"))
        if messagebox.askyesno(_("Switch clock source?"), msg, parent=self.root):
            self.write([(CLOCK, "1" if internal else "0")])

    def render_controls(self):
        vals = self.values
        # Addendum (2026-10-19): computed once per poll, read by the
        # ENUM_BUTTONS loop below - see feedback_loop_active()'s own
        # comment and FEEDBACK_LOOP_TEXT.
        feedback_loop = feedback_loop_active(vals)
        lit = {}
        for num, name in SWITCH_BUTTONS.items():
            on = vals.get(name) == "on"
            self.state[name] = on
            lit[num] = on
        for name, var in self.enum_vars.items():
            try:
                current = int(vals.get(name, -1))
            except ValueError:
                current = -1
            current = current if 0 <= current < len(ADC_SOURCE_ITEMS[name]) else -1
            var.set(current)
            for idx, widget in enumerate(self.control_widgets.get(name, [])):
                if hasattr(widget, "control_label") and name in self.enum_vars:
                    widget.configure(text=("●  " if idx == current else "○  ") + widget.control_label)
        for name, var in self.switch_vars.items():
            var.set(vals.get(name) == "on")
        for name, widgets in self.control_widgets.items():
            enabled = name in vals and not self.writing
            if name in RIAA_NAMES:
                source = f"In {('1/2', '3/4')[RIAA_NAMES.index(name)]} Capture Source"
                enabled = enabled and vals.get(source) == str(ADC_SOURCE_ITEMS[source].index("Phono"))
            if name == "Direct 1/2 Mono Playback Switch":
                enabled = enabled and vals.get("In 1/2 Capture Source") == "0" and vals.get("Direct 1/2 Playback Switch") == "on"
            for widget in widgets:
                widget.configure(state="normal" if enabled else "disabled")
                if name in self.switch_vars:
                    widget.configure(text=("■  " if vals.get(name) == "on" else "□  ") + widget.control_label,
                                     fg=ACCENT if vals.get(name) == "on" else DIM_TEXT,
                                     selectcolor="#36482c" if enabled else CARD)
        can_preset = not self.writing and set(PRESET_NAMES) <= set(vals)
        self.load_button.configure(state="normal" if can_preset else "disabled")
        self.save_button.configure(state="normal" if can_preset else "disabled")
        for num, (name, item) in ENUM_BUTTONS.items():
            items = ADC_SOURCE_ITEMS[name]
            try:
                index = int(vals.get(name, -1))
                cur = items[index] if 0 <= index < len(items) else None
            except (ValueError, IndexError):
                cur = None
            lit[num] = (cur == item)
            # Addendum (2026-10-19): live loopback-source indicator - this
            # loop (unlike the enum_vars one above) runs identically in
            # both plain and skinned mode, since skinned mode never
            # populates self.enum_vars at all (it tracks enum state only
            # via ENUM_BUTTONS/lit/draw()) - needed here, not there, for
            # the indicator to actually update under a skin.
            if item == LOOPBACK_ITEM.get(name):
                label = self.loopback_labels.get(name)
                if label is not None:
                    # Addendum (2026-10-19): the feedback-loop warning
                    # overrides the plain per-pair indicator on *both*
                    # inputs at once - reverts the moment any one of the
                    # four conditions goes away (feedback_loop recomputed
                    # fresh every render_controls() call, never sticky).
                    if feedback_loop:
                        label.configure(text=FEEDBACK_LOOP_TEXT, fg=AMBER)
                    else:
                        label.configure(text=LOOPBACK_STATUS[name] if lit[num] else "", fg=ACCENT)
        for num, on in lit.items():
            if num in self.widgets:
                self.draw(num, on)

