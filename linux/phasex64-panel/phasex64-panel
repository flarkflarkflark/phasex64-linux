    def _replace_midi_text(self, text):
        if self.midi_monitor_widget is None:
            return
        self.midi_monitor_widget.configure(state="normal")
        self.midi_monitor_widget.delete("1.0", "end")
        if text:
            self.midi_monitor_widget.insert("end", text)
        self.midi_monitor_widget.configure(state="disabled")
        self.midi_monitor_widget.see("end")

    def render_midi_monitor(self, status):
        labels = {
            "connected": (_("Connected"), ACCENT, _("Waiting for MIDI input…")),
            "disconnected": (_("Disconnected"), MUTED, _("PHASE MIDI port disconnected.")),
            "unavailable": (_("Monitor unavailable"), AMBER,
                            _("aseqdump is unavailable or could not subscribe.")),
            "demo": (_("Demo"), DIM_TEXT, _("MIDI monitor is offline in demo mode.")),
            "connecting": (_("Connecting…"), DIM_TEXT, _("Resolving PHASE MIDI port…")),
        }
        label, colour, placeholder = labels.get(
            status, (_("Monitor unavailable"), AMBER,
                     _("aseqdump is unavailable or could not subscribe.")))
        if self.midi_monitor_state is not None:
            self.midi_monitor_state.configure(text=label, fg=colour)
        if not self.midi_monitor_lines:
            self._replace_midi_text(placeholder)
        self.midi_monitor_status = status

    def update_midi_stream_hint(self):
        # Addendum (2026-10-19): informational only - never gates the
        # LEDs, the MIDI button, or whether this window can be opened
        # (those stay independent of PCM state, by design). Just sets
        # the right expectation: the hardware only relays MIDI while a
        # stream is active (see analysis/NOTES.md, "Hardware device-gate
        # result"), so a quiet IN monitor while idle is expected, not a
        # sign anything here is broken.
        if self.midi_stream_hint is None:
            return
        base = _("OUT shows activity only (byte counter) - outgoing message "
                 "content cannot be observed.")
        if self.pcm_active is False:
            text, fg = base + " " + _(
                "No audio stream is running - MIDI only flows while one is active."), AMBER
        else:
            text, fg = base, DIM_TEXT
        self.midi_stream_hint.configure(text=text, fg=fg)

    def drain_midi_events(self):
        if self.midi_monitor_widget is None:
            return
        batch = []
        events = self.mixer.midi_monitor.events
        for _ in range(MIDI_MONITOR_BATCH_SIZE):
            try:
                batch.append(events.get_nowait())
            except queue.Empty:
                break
        if not batch:
            return
        # Addendum (2026-10-19): always drain up to a full batch off the
        # queue regardless of the filter below, so the filter can't cause
        # a backlog to build up in `events` - only whether a given line
        # then gets *displayed* depends on the toggle, read fresh here
        # (not latched at drain start), so flipping it takes effect on
        # the very next batch, not just future ones.
        show_clock = self.midi_show_clock_var is not None and self.midi_show_clock_var.get()
        if not show_clock:
            batch = [line for line in batch if not _MIDI_CLOCK_EVENT_RE.match(line)]
        show_system = self.midi_show_system_var is not None and self.midi_show_system_var.get()
        if not show_system:
            batch = [line for line in batch if not _MIDI_SYSTEM_EVENT_RE.match(line)]
        if not batch:
            return
        self.midi_monitor_lines.extend(batch)
        del self.midi_monitor_lines[:-MIDI_MONITOR_MAX_LINES]
        # One Tk mutation per batch, never one per incoming MIDI event.
        self._replace_midi_text("\n".join(self.midi_monitor_lines))

    def update_midi_leds(self, counters=None, now=None):
        now = time.monotonic() if now is None else now
        if counters is not None:
            for index, current in enumerate(counters):
                previous = self.midi_last_counters[index]
                if current is not None and previous is not None and current > previous:
                    self.midi_led_until[index] = now + MIDI_LED_HOLD_SECONDS
                self.midi_last_counters[index] = current
                if current is None:
                    self.midi_led_until[index] = 0.0
        for index, led in self.midi_leds.items():
            available = self.midi_last_counters[index] is not None
            led.configure(fg=ACCENT if now < self.midi_led_until[index]
                          else DIM_TEXT if available else DIM)

    def render_state(self, result):
        # midi_counters deliberately isn't part of this tuple - see
        # PanelIO.run()'s "peaks" branch and update_midi_leds()'s own
        # comment for why it rides the fast 50ms poll instead of this
        # slow ~1s one (LED hold needs sub-second resolution to look
        # right; MIDI device availability below doesn't).
        self.values, rate, active, card, midi_available = result
        self.stream_rate = rate if active else None
        self.card_status = (_("demo") if isinstance(self.mixer, FakeMixer) else
                            _("not connected") if card is None else
                            _("hw:{card} · PHASE X64").format(card=card))
        self.render_controls()
        for num, r in RATE_BUTTONS.items():
            if num in self.widgets:
                self.draw(num, rate == r)
        rate_text = f"{rate / 1000:g} kHz" if rate else None
        clock = {"0": _("Internal"), "1": _("Digital")}.get(self.values.get(CLOCK), "—")
        lock = {"on": _("locked"), "off": _("unlocked")}.get(self.values.get(LOCK), "—")
        # Stream state and samplerate merged into one field, e.g. "idle" or
        # "running 48 kHz" - two separate "idle"/"Stream: no" fields said
        # the same thing twice (fix: panel hardware review, 2026-10-16).
        if active:
            stream = _("running {rate}").format(rate=rate_text) if rate_text else _("running")
        elif active is False:
            stream = _("idle")
        else:
            stream = _("unknown")
        # The rawmidi/ALSA-seq path is independent of PCM. In particular, a
        # PipeWire/WirePlumber bridge can hold it open while PCM is idle.
        # Never infer MIDI availability or activity from `active` here -
        # self.pcm_active below feeds only the monitor window's own
        # informational hint, nothing that gates LEDs/button/window.
        self.pcm_active = active
        self.update_midi_stream_hint()
        # Addendum (2026-10-19, hardware test): this field used to show
        # the monitor *window's* connection state ("closed" whenever the
        # window itself was closed) - misleading, since MIDI (the LEDs,
        # the port) works fine with the window closed; that state belongs
        # only in the monitor window, which already shows "Connected" of
        # its own. This is the rawmidi *device's* presence instead
        # (self.mixer.midi_available() - same one the LEDs' own
        # availability-vs-no-counters-yet distinction already uses),
        # entirely independent of whether the monitor window has ever
        # been opened.
        midi = (_("available") if midi_available else
                _("unavailable") if midi_available is False else
                _("unknown"))
        self.status.configure(text=_(
            "● {status}    |    Clock: {clock}    |    Digital: {lock}    |    "
            "Stream: {stream}    |    MIDI: {midi}").format(
                status=self.card_status, clock=clock, lock=lock, stream=stream, midi=midi))

    def visibility(self, event):
        if event.widget is not self.root:
            return
        if str(event.type) in ("15", "Visibility"):
            self.obscured = str(event.state) in ("2", "VisibilityFullyObscured")
        elif str(event.type) in ("19", "Map"):
            self.obscured = False
        if self.visible():
            self.io.visible.set()
        else:
            self.io.visible.clear()

    def visible(self):
        return bool(self.root.winfo_viewable()) and not self.obscured and self.root.state() != "iconic"

    def tick(self):
        if self.closed:
            return
        now = time.monotonic()
        if self.visible():
            self.io.visible.set()
        else:
            self.io.visible.clear()
        while True:
            try:
                kind, result, error = self.io.results.get_nowait()
            except queue.Empty:
                break
            if kind == "state":
                self.pending_state = False
                if error:
                    self.render_state(({}, None, None, None, None))
                    self.notice.configure(text=error, fg=RED)
                else:
                    self.render_state(result)
            elif kind == "peaks":
                self.pending_peaks = False
                peaks, midi_counters = (None, None) if error else result
                for name, meter in self.meters.items():
                    meter.draw(None if error else peaks.get(name))
                self.update_midi_leds(midi_counters)
            elif kind == "write":
                self.writing = False
                self.next_state = 0
                if error:
                    text = _("Apply failed (some controls may have changed): {error}").format(error=error)
                elif self.live_apply_capable:
                    text = _("Applied live.")
                else:
                    text = _("Control state written · restart an active stream to apply codec routing.")
                self.notice.configure(text=text, fg=RED if error else ACCENT)
            elif kind == "midi_start":
                self.pending_midi_monitor = False
                if self.midi_window is not None and not self.midi_monitor_closing:
                    self.render_midi_monitor("unavailable" if error else result)
            elif kind == "midi_stop":
                self._finish_midi_monitor_close()
            elif kind in ("buffer_state", "buffer_set", "buffer_keep"):
                self.handle_buffer_result(kind, result, error)
        if self.io.changed.is_set():
            self.io.changed.clear()
            self.next_state = 0
        monitor_status = self.mixer.midi_monitor.status()
        if self.midi_window is not None and not self.midi_monitor_closing and \
                monitor_status != self.midi_monitor_status:
            # Subscription failures can happen just after Popen; reflect the
            # reader thread's state promptly instead of waiting for PCM/control
            # state or using it as a proxy.
            self.render_midi_monitor(monitor_status)
        self.drain_midi_events()
        self.update_midi_leds(now=now)
        if self.midi_window is not None and not self.midi_monitor_closing and \
                not self.pending_midi_monitor and now >= self.next_midi_monitor:
            self.pending_midi_monitor = True
            self.next_midi_monitor = now + 1
            self.io.submit("midi_start")
        if self.io.visible.is_set():
            if not self.pending_state and now >= self.next_state:
                self.pending_state = True
                self.next_state = now + 1
                self.io.submit("state")
            if self.buffer_choice is not None and not self.pending_buffer_state and \
                    now >= self.next_buffer_state:
                self.pending_buffer_state = True
                self.next_buffer_state = now + 1
                self.io.submit("buffer_state")
            if not self.pending_peaks and now >= self.next_peak:
                self.pending_peaks = True
                self.next_peak = now + .05
                self.io.submit("peaks")
        self.refresh_job = self.root.after(50, self.tick)


def _lock_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        return Path(runtime_dir) / (APP + ".lock")
    return Path(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))) / APP / "panel.lock"


def acquire_single_instance_lock(bypass):
    """Non-blocking fcntl flock so a second `phasex64-panel` refuses to
    start while one is already running (the panel is usually launched
    from an application menu, so a stray second instance is easy to
    start without noticing - see analysis/NOTES.md "Open items").

    Returns (True, file-or-None) if bypassed or acquired - the caller
    must keep a reference to the returned file object for as long as the
    lock should be held; closing it (including implicitly, at process
    exit for any reason, even SIGKILL) releases the flock automatically,
    so there's no stale-lock case to handle. Returns (False, None) if
    another instance already holds it.
    """
    if bypass:
        return True, None
    path = _lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = open(path, "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock_file.close()
        return False, None
    return True, lock_file


def show_already_running_dialog(root):
    """Small themed dialog (same dark-theme pattern as Panel.about()'s own
    Toplevel) telling the user a panel instance is already running, since
    the panel is normally started from an application menu - a message on
    stderr alone would never be seen there.
    """
    root.withdraw()
    top = tk.Toplevel(root, bg=BG)
    top.title(APP)
    top.resizable(False, False)
    tk.Label(top, text=_("PHASE X64 panel is already running"), bg=BG, fg=TEXT,
            justify="left", anchor="w", font=("DejaVu Sans", 10),
            padx=20, pady=16).pack(fill="both", expand=True)
    ok = tk.Button(top, text=_("OK"), command=top.destroy, bg=EDGE, fg=TEXT,
                   activebackground="#48545e", activeforeground=ACCENT,
                   relief="flat", bd=0, padx=13, pady=7,
                   highlightthickness=1, highlightbackground=EDGE)
    ok.pack(pady=(0, 16))
    top.bind("<Return>", lambda e: top.destroy())
    top.bind("<Escape>", lambda e: top.destroy())
    top.protocol("WM_DELETE_WINDOW", top.destroy)
    # Deliberately NOT top.transient(root): root is withdrawn (never
    # shown - it exists only as this dialog's technical owner before
    # this process exits), and at least one window manager tested
    # (KWin) follows ICCCM to the letter here and refuses to ever map a
    # window that's transient-for a withdrawn one - the dialog silently
    # never appears, hanging in wait_window() forever with nothing the
    # user could click. grab_set() alone still gets the modal behaviour
    # this dialog actually needs.
    top.grab_set()
    top.wait_window()


def main():
    ap = argparse.ArgumentParser(description="PHASE X64 USB control panel")
    ap.add_argument("--import-skin", metavar="DIR",
                    help="copy the skin from the Windows driver package")
    ap.add_argument("--skin", metavar="DIR", nargs="?", const="auto", help="opt in to an imported Windows skin")
    ap.add_argument("--plain", action="store_true", help="use the default native studio interface")
    ap.add_argument("--version", action="version", version=VERSION)
    ap.add_argument("--demo", action="store_true", help="offline demo with simulated peak controls")
    ap.add_argument("--demo-active", action="store_true", help="start --demo with its signal generator enabled")
    ap.add_argument("--fake-mixer", action="store_true",
                    help="use an in-memory fake mixer instead of a real card "
                         "(for testing without hardware)")
    # Test-only hook (test_panel.py's signal-handling tests): spawns one
    # long-lived stand-in child the same way (_with_pdeathsig()-wrapped
    # Popen) the real alsactl/aseqdump monitors do, and prints its PID so
    # a test can watch whether it outlives this process. Hidden from
    # --help - not a real feature.
    ap.add_argument("--test-spawn-stand-in-child", action="store_true",
                    help=argparse.SUPPRESS)
    args = ap.parse_args()

    if args.import_skin:
        import_skin(args.import_skin)
        return

    if args.demo_active and not args.demo:
        ap.error("--demo-active requires --demo")
    if args.demo or args.fake_mixer:
        mixer = FakeMixer(demo=args.demo)
        mixer.signal = args.demo_active
    else:
        card = find_card()
        mixer = Mixer(card)
    skin = None if args.plain or not args.skin else find_skin(None if args.skin == "auto" else args.skin)
    if args.skin and not args.plain and not skin:
        ap.error("skin not found; import one with --import-skin or omit --skin")

    # className sets WM_CLASS's class part - Tk capitalizes it
    # ("Phasex64-panel", confirmed via winfo_class()), so the .desktop
    # file's StartupWMClass is "Phasex64-panel" too, not this literal
    # string. Lets the window manager/taskbar associate this window with
    # the launcher (and its icon) even launched from a terminal rather
    # than the .desktop entry.
    root = tk.Tk(className="phasex64-panel")
    icons = find_icon_images()
    if icons:
        root.iconphoto(True, *icons)

    # Demo/fake-mixer instances never touch real hardware, so several can
    # run at once harmlessly (and tests rely on that) - bypass the lock
    # for them automatically. PHASEX64_PANEL_NO_LOCK is the explicit
    # override for anything else that needs to bypass it (e.g. a test
    # exercising the lock mechanism itself with a real-mixer-shaped run).
    bypass_lock = args.demo or args.fake_mixer or \
        os.environ.get("PHASEX64_PANEL_NO_LOCK") == "1"
    acquired, lock_file = acquire_single_instance_lock(bypass_lock)
    if not acquired:
        show_already_running_dialog(root)
        root.destroy()
        return

    panel = Panel(root, mixer, skin)

    if args.test_spawn_stand_in_child:
        stand_in = subprocess.Popen(
            _with_pdeathsig([sys.executable, "-c", "import time; time.sleep(60)"]))
        print("stand_in_pid %d" % stand_in.pid, flush=True)

    # Signal handlers run on the main thread only, and only between Python
    # bytecode instructions - never safe to touch Tk widgets from here
    # directly (wrong thread-safety assumptions even though this *is* the
    # main thread, since Tk's C-level mainloop may be mid-callback).
    # root.after(0, ...) hands the real cleanup back to Tk's own event
    # loop instead, same as WM_DELETE_WINDOW - no second close path.
    # Tk returns control to Python bytecode (where a pending signal
    # actually gets delivered) on every after() callback; tick()'s own
    # 50ms self-reschedule (see Panel.tick) already guarantees that
    # happens often enough for this to run well within the ~0.5s this
    # needs to beat, with no change needed there.
    def handle_terminate(signum, frame):
        root.after(0, panel.close)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, handle_terminate)

    try:
        root.mainloop()
    finally:
        panel.close()


if __name__ == "__main__":
    main()
