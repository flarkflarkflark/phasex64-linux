        bg = self.load_image(skin, info.get("BACKGROUND", "BG_Page_Main.png"))
        if bg is None:
            raise ValueError("Skin background image is missing")
        self.canvas = tk.Canvas(self.root, width=bg.width(), height=bg.height(),
                                highlightthickness=0, bd=0)
        self.canvas.pack()
        self.canvas.create_image(0, 0, image=bg, anchor="nw")
        self.images = [bg]
        tx, ty = int(info.get("TXTOUTX", 24)), int(info.get("TXTOUTY", 267))
        tw = int(info.get("TXTOUTW", 652))
        self.help = self.canvas.create_text(tx, ty + 8, anchor="w", width=tw,
                                            fill="#d0d0d0",
                                            font=("Sans", 8))
        for num, b in buttons.items():
            if "BPIC" not in b or "xBTN" not in b:
                continue
            x, y = int(b["xBTN"]), int(b["yBTN"])
            if x >= 1000:
                continue
            if num not in ENUM_BUTTONS and num not in SWITCH_BUTTONS and \
                    num not in RATE_BUTTONS and num not in (BTN_INFO, BTN_CLOSE):
                continue    # latency buttons: buffer size is set by the audio app
            sheet = self.load_image(skin, b["BPIC"])
            if sheet is None:
                continue
            h = sheet.height() // 4
            frames = []
            for i in range(4):
                fr = tk.PhotoImage(width=sheet.width(), height=h)
                fr.tk.call(fr, "copy", sheet, "-from", 0, i * h,
                           sheet.width(), (i + 1) * h, "-to", 0, 0)
                frames.append(fr)
            self.images += [sheet] + frames
            item = self.canvas.create_image(x, y, image=frames[0], anchor="nw")
            self.widgets[num] = (item, frames)
            self.canvas.tag_bind(item, "<Button-1>",
                                 lambda e, n=num: self.click(n))
            self.canvas.tag_bind(item, "<Enter>",
                                 lambda e, n=num: self.show_help(n))
            self.canvas.tag_bind(item, "<Leave>",
                                 lambda e: self.show_help(None))

    def show_help(self, num):
        if hasattr(self, "help"):
            self.canvas.itemconfigure(self.help,
                                      text=self.texts.get(num, "").replace("Sound Module", "DSP") if num else "")

    def draw(self, num, on):
        item, frames = self.widgets[num]
        self.canvas.itemconfigure(item, image=frames[1 if on else 0])

