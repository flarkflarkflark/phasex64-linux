            disabledforeground=DIM, highlightthickness=0, bd=0)
        self.buffer_keep.pack(side="left", padx=(4, 0))
        Tooltip(self.buffer_keep, _(
            "Also make this size PipeWire's default, in "
            "~/.config/pipewire/pipewire.conf.d/20-phasex64-buffer.conf. Takes effect "
            "for new sessions after a PipeWire restart; the size chosen here is "
            "applied immediately anyway. Untick to remove that file."))

    def buffer_available(self):
        return bool(self.buffer_state and self.buffer_state.get("available"))

    def buffer_tooltip(self):
        if self.buffer_state is not None and not self.buffer_available():
            return _("Requires PipeWire. With JACK2 set the buffer in JACK; with plain "
                     "ALSA the application chooses it.")
        return _("PipeWire buffer size (quantum) in samples, applied live to the whole "
                 "PipeWire graph. Smaller means less latency and more CPU load. Stable "
                 "on hardware: 64, 128, 256 and 1024; 512 and 2048 untested but within "
                 "that range. A live change can cause a short click. Auto lets "
                 "PipeWire decide.")

    def selected_buffer(self):
        text = self.buffer_choice.get()
        for quantum in BUFFER_CHOICES:
            if text == self.buffer_choice_label(quantum):
                return quantum
        return None

    def render_buffer_state(self, state):
        self.buffer_state = state
        if self.buffer_choice is None:
            return
        available = self.buffer_available()
        self.buffer_choice.configure(state="readonly" if available else "disabled")
        self.buffer_keep.configure(state="normal" if available else "disabled")
        self.buffer_keep_var.set(bool(state.get("persisted")))
        if not available:
            self.buffer_label.configure(text="—")
            return
        if self.buffer_busy:
            return
        forced = state.get("forced", 0)
        self.buffer_choice.set(self.buffer_choice_label(forced))
        if forced:
            text = format_buffer_latency(forced, self.stream_rate or state.get("rate"))
        elif state.get("running"):
            quantum, rate = state["running"]
            text = _("auto: {latency}").format(latency=format_buffer_latency(quantum, rate))
        else:
            text = _("auto")
        self.buffer_label.configure(text=text)

    def on_buffer_selected(self, _event=None):
        quantum = self.selected_buffer()
        if quantum is None or not self.buffer_available():
            return
        self.buffer_busy = True
        self.io.submit("buffer_set", quantum)
        if self.buffer_keep_var.get():
            # Keep the drop-in in step with the new size; the "Buffer set"
            # notice is the one worth showing here, so this one stays quiet.
            self.io.submit("buffer_keep", (quantum, self.buffer_state.get("min"), False))

    def on_buffer_keep(self):
        if not self.buffer_available():
            return
        quantum = self.selected_buffer() if self.buffer_keep_var.get() else None
        if self.buffer_keep_var.get() and not quantum:
            self.buffer_keep_var.set(False)
            self.notice.configure(text=_("Choose a buffer size first; Auto is already "
                                         "PipeWire's default."), fg=MUTED)
            return
        self.buffer_busy = True
        self.io.submit("buffer_keep", (quantum, self.buffer_state.get("min"), True))

    def handle_buffer_result(self, kind, result, error):
        if kind == "buffer_state":
            self.pending_buffer_state = False
            self.render_buffer_state({"available": False} if error else result)
            return
        self.buffer_busy = False
        self.next_buffer_state = 0
        if error:
            self.notice.configure(text=_("Buffer change failed: {error}").format(error=error), fg=RED)
        elif kind == "buffer_set":
            if result:
                text = _("Buffer set: {latency}.").format(
                    latency=format_buffer_latency(result, self.stream_rate or
                                                  (self.buffer_state or {}).get("rate")))
            else:
                text = _("Buffer set: Auto (PipeWire decides).")
            self.notice.configure(text=text, fg=ACCENT)
        elif not result[1]:
            return
        elif result[0]:
            self.notice.configure(text=_("Kept after restart: buffer {size} becomes PipeWire's "
                                         "default after the next PipeWire restart.").format(size=result[0]),
                                  fg=ACCENT)
        else:
            self.notice.configure(text=_("No longer kept after restart."), fg=ACCENT)

