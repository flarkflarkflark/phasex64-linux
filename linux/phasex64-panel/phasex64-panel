                                     font=("DejaVu Sans Mono", 9), width=BUFFER_LABEL_CHARS)
        self.buffer_label.pack(side="left", padx=(8, 0))
        Tooltip(self.buffer_label, _("One buffer period at the current sample rate. The total "
                                     "round-trip latency through the interface is higher."))
        self.buffer_keep_var = tk.BooleanVar(value=False)
        self.buffer_keep = tk.Checkbutton(
            frame, text=_("Keep after restart"), variable=self.buffer_keep_var,
            command=self.on_buffer_keep, state="disabled", bg=BG, fg=TEXT,
