    def preset_entries(self):
        """[(id, displayed label), ...] - built-ins (translated label)
        first, then custom presets (their own name, as typed)."""
        entries = [(pid, builtin_preset_label(pid)) for pid in self.presets.builtin_ids()]
        entries += [(name, name) for name in self.presets.custom_names()]
        return entries

    def refresh_preset_choices(self, select_id=None):
        entries = self.preset_entries()
        self.preset_ids = [pid for pid, _label in entries]
        self.preset_choice.configure(values=[label for _pid, label in entries])
        if select_id is not None and select_id in self.preset_ids:
            self.preset_choice.current(self.preset_ids.index(select_id))
        elif self.preset_choice.current() < 0 and self.preset_ids:
            self.preset_choice.current(0)

