            _("MIDI: input monitor window state; independent of PCM stream state."),
        ]))

    def toggle_demo(self):
        self.mixer.signal = self.demo_signal.get()
        self.next_state = 0

    def write(self, changes):
        if self.writing:
            return
        self.writing = True
        self.notice.configure(text=_("Applying control state…"), fg=ACCENT)
        self.io.submit("write", changes)
        self.render_controls()

    def load_preset(self):
        try:
            idx = self.preset_choice.current()
            if idx < 0 or idx >= len(self.preset_ids):
                return
            controls = self.presets.load(self.preset_ids[idx])
            missing = set(controls) - set(self.values)
            if missing:
                raise ValueError(_("Preset controls unavailable: {names}").format(
                    names=", ".join(sorted(missing))))
            self.write(preset_writes(controls))
        except (ValueError, OSError) as exc:
            self.notice.configure(text=str(exc), fg=RED)

    def save_preset(self):
        name = simpledialog.askstring(_("Save preset"), _("Preset name"), parent=self.root)
        if not name:
            return
        try:
            path = self.presets.path(name)
            if path.exists() and not messagebox.askyesno(_("Replace preset?"), name, parent=self.root):
                return
            self.presets.save(name, preset_from_values(self.values))
            self.refresh_preset_choices(select_id=name)
            self.notice.configure(text=_("Saved {name}").format(name=name), fg=ACCENT)
        except (ValueError, OSError) as exc:
            self.notice.configure(text=str(exc), fg=RED)

    def about(self):
        # Addendum (2026-10-19): a custom Toplevel, not messagebox.
