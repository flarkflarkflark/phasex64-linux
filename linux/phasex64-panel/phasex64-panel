def read_driver_version():
    # This is a cosmetic hint, not core functionality - any failure here
    # (missing file, a sysfs read racing a module unload, unexpected
    # content) must fall back to None (treated as "not live-apply-capable")
    # rather than ever taking the whole panel down at startup.
    try:
        with open(DRIVER_VERSION_SYSFS, encoding="ascii") as f:
            raw = f.read().strip()
    except (OSError, UnicodeDecodeError):
        return None
    m = re.match(r"(\d+(?:\.\d+)*)", raw)
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def version_at_least(version, minimum):
    if version is None:
        return False
    width = max(len(version), len(minimum))

    def pad(v):
        return tuple(v) + (0,) * (width - len(v))

    return pad(version) >= pad(minimum)


