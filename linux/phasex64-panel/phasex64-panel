    return {"vinyl": vinyl, "monitor": monitor}


def validate_preset(controls):
    if not isinstance(controls, dict) or set(controls) != set(PRESET_NAMES):
        raise ValueError(_("Preset must contain exactly the codec and RIAA controls"))
    for name, value in controls.items():
        if name in ADC_SOURCE_ITEMS:
            if type(value) is not int or not 0 <= value < len(ADC_SOURCE_ITEMS[name]):
                raise ValueError(_("Invalid source: {name}").format(name=name))
        elif type(value) is not bool:
            raise ValueError(_("Expected an on/off value: {name}").format(name=name))
    if controls["Direct 1/2 Mono Playback Switch"] and (
            controls["In 1/2 Capture Source"] != 0 or not controls["Direct 1/2 Playback Switch"]):
        raise ValueError(_("Direct mono 1/2 requires Mic/HiZ/Line and Direct on"))
    return dict(controls)


def preset_from_values(values):
    controls = {}
    for name in PRESET_NAMES:
        if name not in values:
            raise ValueError(_("Cannot save: control unavailable: {name}").format(name=name))
        if name in ADC_SOURCE_ITEMS:
            controls[name] = int(values[name])
        elif values[name] in ("on", "off"):
            controls[name] = values[name] == "on"
        else:
            raise ValueError(_("Invalid control value: {name}").format(name=name))
    return validate_preset(controls)


def preset_writes(controls):
    controls = validate_preset(controls)  # validate the WHOLE file before I/O
    mono = "Direct 1/2 Mono Playback Switch"
    # Disable the interlocked bit first, then sources/routes, then enable it last.
    writes = [(mono, "off")]
    for name in PRESET_NAMES:
        if name != mono:
            value = controls[name]
            writes.append((name, str(value) if name in ADC_SOURCE_ITEMS else "on" if value else "off"))
    writes.append((mono, "on" if controls[mono] else "off"))
    return writes


class Presets:
    """Built-in presets are addressed by stable id (BUILTIN_PRESET_IDS);
    user presets by their own filesystem-safe name, same as before. The
    Panel is responsible for mapping the combobox's displayed (and
    translated, for built-ins) text back to one of these before calling
    load()/save() - see Panel.preset_entries()/load_preset()/save_preset().
    """

    def __init__(self, directory=None):
        self.directory = Path(directory) if directory else Path(
            os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))) / APP / "presets"

    def builtin_ids(self):
        return list(BUILTIN_PRESET_IDS)

    def custom_names(self):
        builtin = set(builtin_presets())
        return sorted(p.stem for p in self.directory.glob("*.json") if p.stem not in builtin)

    def path(self, name):
        if not name or len(name) > 80 or any(not (c.isalnum() or c in " _-") for c in name):
            raise ValueError(_("Use letters, numbers, spaces, - or _ in a preset name"))
        return self.directory / (name + ".json")

    def load(self, preset_id):
        if preset_id in builtin_presets():
            return builtin_presets()[preset_id]
        with self.path(preset_id).open(encoding="utf-8") as stream:
            text = stream.read(65537)
        if len(text) > 65536:
            raise ValueError(_("Preset is too large"))
        data = json.loads(text)
        if not isinstance(data, dict) or type(data.get("schema")) is not int or data["schema"] != 1:
            raise ValueError(_("Unsupported preset schema"))
        return validate_preset(data.get("controls"))

    def save(self, name, controls):
        controls = validate_preset(controls)
        path = self.path(name)
        if name in builtin_presets():
            raise ValueError(_("Choose a different name; built-in examples are read-only"))
        self.directory.mkdir(parents=True, exist_ok=True)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.directory,
                                             prefix=".preset-", delete=False) as stream:
                temporary = Path(stream.name)
                json.dump({"schema": 1, "name": name, "controls": controls}, stream,
                          ensure_ascii=False, indent=2)
                stream.write("\n")
            os.replace(temporary, path)
        finally:
            if temporary is not None and temporary.exists():
                temporary.unlink()


class PanelIO:
    """Single owner of ALSA requests. Never touches Tk from a worker thread."""
    def __init__(self, mixer):
        self.mixer = mixer
        self.requests, self.results = queue.Queue(), queue.Queue()
        self.stop = threading.Event()
        self.visible = threading.Event()
        self.changed = threading.Event()
        self.mixer.cancel = self.stop
        self.last_peak = 0.0
        self.thread = threading.Thread(target=self.run, daemon=True, name="phasex64-panel-io")
        self.thread.start()

    def submit(self, kind, payload=None):
        self.requests.put((kind, payload))

    def run(self):
        try:
            while not self.stop.is_set():
                try:
                    kind, payload = self.requests.get(timeout=.1)
                except queue.Empty:
                    continue
                if self.stop.is_set():
                    break
                try:
                    if kind == "state":
                        # This thread (PanelIO's own worker) is the one
                        # and only caller - required for the alsactl
                        # child's PDEATHSIG (_with_pdeathsig's own
                        # comment) to fire against this thread's actual
                        # lifetime, which matches the panel's.
                        self.mixer.ensure_change_monitor(self.changed.set)
                        # Opening the ALSA-seq monitor is an explicit UI
                        # action, never a side effect of this poll. Neither
                        # this nor the rawmidi counters below (moved to the
                        # "peaks" branch - see its own comment) use PCM
                        # state as a proxy for MIDI availability/activity.
                        # midi_available() (the rawmidi *device*, not the
                        # monitor window's own aseqdump subprocess state -
                        # see that method's own comment) feeds the status
                        # bar; the monitor window gets its own connection
                        # state separately, straight from
                        # self.mixer.midi_monitor.status() in tick(), not
                        # through this tuple at all.
                        values = self.mixer.contents()
                        result = (values, self.mixer.rate(), self.mixer.stream_active(),
                                  self.mixer.card, self.mixer.midi_available())
                    elif kind == "midi_start":
                        # Same requirement as the "state" branch's own
                        # comment above, for aseqdump's PDEATHSIG - this
                        # worker thread is the only caller of ensure().
                        result = self.mixer.midi_monitor.ensure()
                    elif kind == "midi_stop":
                        self.mixer.midi_monitor.stop()
                        result = self.mixer.midi_monitor.status()
                    elif kind == "buffer_state":
                        result = self.mixer.buffer.state()
                    elif kind == "buffer_set":
                        result = self.mixer.buffer.apply(payload)
                    elif kind == "buffer_keep":
                        quantum, min_quantum, announce = payload
                        result = (self.mixer.buffer.persist(quantum, min_quantum), announce)
                    elif kind == "peaks":
                        # No catch-up bursts after a slow state read or write.
                        if self.stop.wait(max(0, .05 - (time.monotonic() - self.last_peak))):
                            break
                        self.last_peak = time.monotonic()
                        peaks = self.mixer.peaks(self.visible) if self.visible.is_set() else {}
                        # Addendum (2026-10-19): rawmidi Rx/Tx byte counters
                        # ride this fast ~50ms poll, not the slow ~1s
                        # "state" one - a cheap /proc read, trivial next to
                        # the per-peak-name amixer subprocess calls peaks()
                        # already does at this same cadence. LED hold
                        # (MIDI_LED_HOLD_SECONDS) needs sub-second
                        # resolution to look like a steady glow under
                        # continuous traffic (e.g. MIDI clock) rather than
                        # a ~1Hz flicker - sampling once a second like the
                        # rest of "state" would defeat that regardless of
                        # the exact hold value.
                        result = (peaks, self.mixer.midi_counters())
                    elif kind == "write":
                        for name, value in payload:
                            if self.stop.is_set():
                                break
                            self.mixer.set(name, value)
                        result = None
                    else:
                        continue
                    self.results.put((kind, result, None))
                except (RuntimeError, ValueError, OSError) as exc:
                    self.results.put((kind, None, str(exc)))
        finally:
            self.mixer.midi_monitor.close()
            self.mixer.stop_change_monitor()

    def close(self):
        self.visible.clear()
        self.stop.set()
        # One bounded request may still be in flight; queued writes are discarded.
        self.thread.join(timeout=5.0)


class Tooltip:
    """A themed hover tooltip - Tk has no built-in one. Shows after a short
    delay, hides on leave or click, follows the dark theme, wraps around
    40 characters. `text` may be a 0-argument callable for dynamic content
    (e.g. the Direct Mono tooltip, which explains *why* it's disabled right
    now, not just what it does in general).

    One Tooltip per widget; the widget keeps a reference to it
    (`widget._tooltip`) so tests can verify coverage without duplicating
    the widget inventory.
    """
    DELAY_MS = 500
    WRAP = 300  # pixels; ~40 characters at this font size

    def __init__(self, widget, text):
        self.widget = widget
        self.text = text
        self.after_id = None
        self.window = None
        widget._tooltip = self
        widget.bind("<Enter>", self._schedule, add="+")
        widget.bind("<Leave>", self._hide, add="+")
        widget.bind("<Button-1>", self._hide, add="+")
        widget.bind("<Destroy>", self._hide, add="+")

    def _schedule(self, event=None):
        self._cancel_timer()
        self.after_id = self.widget.after(self.DELAY_MS, self._show)

    def _cancel_timer(self):
        if self.after_id is not None:
            try:
                self.widget.after_cancel(self.after_id)
            except tk.TclError:
                pass
            self.after_id = None

    def _show(self):
        self.after_id = None
        if self.window is not None:
            return
        text = self.text() if callable(self.text) else self.text
        if not text:
            return
        try:
            x = self.widget.winfo_rootx() + 12
            y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6
        except tk.TclError:
            return
        self.window = tk.Toplevel(self.widget)
        self.window.wm_overrideredirect(True)
        try:
            self.window.wm_attributes("-topmost", True)
        except tk.TclError:
            pass
        self.window.wm_geometry(f"+{x}+{y}")
        self.window.configure(bg=EDGE)
        tk.Label(self.window, text=text, bg=TOOLTIP_BG, fg=TEXT, wraplength=self.WRAP,
                 justify="left", padx=8, pady=5, font=("DejaVu Sans", 8)).pack(
                     padx=1, pady=1)

    def _hide(self, event=None):
        self._cancel_timer()
        if self.window is not None:
            try:
                self.window.destroy()
            except tk.TclError:
                pass
            self.window = None


def bind_wraplength(label, container, margin=24, minimum=80):
    """Keep `label`'s wraplength tracking `container`'s current width, so
    the text can never clip regardless of window/column size - a static
    guess would still clip at some width."""
    def update(event=None):
        width = container.winfo_width()
        if width > 1:
            label.configure(wraplength=max(minimum, width - margin))
    container.bind("<Configure>", update, add="+")
    label.after_idle(update)


class PeakMeter(tk.Canvas):
    """Stereo sample-peak display (dBFS), not an analog RMS/VU calibration."""
    HOLD_SECONDS = 3.0

    def __init__(self, parent):
        super().__init__(parent, width=240, height=118, bg=CARD, highlightthickness=0)
        self.levels = [-60.0, -60.0]
        self.hold_db = None  # None <=> "-inf dBFS" (silence)
        self.hold_clip = False
        self.hold_ready = False
        self.last = time.monotonic()
        self.tag_bind("readout", "<Button-1>", self._reset_hold)
        self.draw(None)

    def _reset_hold(self, event=None):
        # Real hardware, 2026-10-16: the readout tracked the raw per-poll
        # peak, which on sustained/compressed music can sit on the same
        # ceiling for minutes and read as a stuck display rather than a
        # meter. Make the hold explicit (HOLD_SECONDS) instead, with a
        # click on the number forcing it to re-latch to the live peak
        # immediately rather than waiting out the hold window.
        self.hold_ready = False

    def draw(self, pair):
        now = time.monotonic()
        elapsed, self.last = now - self.last, now
        self.delete("all")
        enabled = pair is not None
        self.create_text(6, 10, anchor="w", text=_("L / R   ·   SAMPLE PEAK"),
                         fill=DIM_TEXT if enabled else DIM, font=("DejaVu Sans", 8))
        for channel, y in enumerate((32, 53)):
            target = peak_db(pair[channel]) if enabled else -60.0
            self.levels[channel] = max(target, self.levels[channel] - 36 * elapsed) if enabled else -60.0
            self.create_text(6, y + 5, text="LR"[channel], anchor="w", fill=DIM_TEXT, font=("DejaVu Sans", 8))
            for segment in range(30):
                threshold = -60 + (segment + 1) * 2
                colour = RED if threshold > -4 else ACCENT if threshold > -12 else CYAN
                lit = enabled and self.levels[channel] >= threshold
                self.create_rectangle(22 + segment * 7, y, 27 + segment * 7, y + 10,
                                      fill=colour if lit else "#303a41", outline="")
        if enabled:
            maximum = max(pair)
            current_db = None if not maximum else 20 * math.log10(maximum / PEAK_MAX)
            current_key = current_db if current_db is not None else float("-inf")
            held_key = self.hold_db if self.hold_db is not None else float("-inf")
            # Explicit peak hold, not a raw per-poll reading (real
            # hardware, 2026-10-16): sustained/compressed music can hit
            # the same ceiling poll after poll, which read as a stuck
            # display rather than a meter. Hold the peak for HOLD_SECONDS
            # (jumping up immediately on a new, higher peak), then
            # re-latch to whatever is live; click the number (see
            # _reset_hold) to re-latch early.
            if not self.hold_ready or current_key >= held_key or now - self.hold_started >= self.HOLD_SECONDS:
                self.hold_db, self.hold_clip, self.hold_started, self.hold_ready = (
                    current_db, maximum == PEAK_MAX, now, True)
            label = _("−∞ dBFS") if self.hold_db is None else _("{value:.1f} dBFS").format(value=self.hold_db)
            # Own rows, not shared with the scale legend below (real
            # hardware, 2026-10-16): a wide readout like "−64.9 dBFS"
            # (anchor "e") used to run left into the tail of "−60 −36
            # −12" (anchor "w") when both sat on the same y, producing
            # "−12-64.9 dBFS". Separate rows make that impossible
            # regardless of how wide either string is.
            self.create_text(22, 74, text="−60     −36     −12", anchor="w", fill=DIM_TEXT, font=("DejaVu Sans", 8))
            self.create_text(232, 96, text=label, anchor="e", fill=RED if self.hold_clip else TEXT,
                             font=("DejaVu Sans Mono", 9), tags="readout")
        else:
            self.hold_ready = False
            self.create_text(120, 92, text=_("needs driver ≥ 0.1.11.5"), fill=DIM_TEXT,
                             font=("DejaVu Sans", 9), width=220, justify="center")


def parse_script(path):
    """Parse the [MAIN] section of the skin's script.txt."""
    buttons, section, info = {}, None, {}
    with open(path, encoding="latin-1") as f:
        for raw in f:
            line = raw.split("#", 1)[0].strip()
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                continue
            if section != "MAIN" or "=" not in line:
                continue
            key, val = (s.strip() for s in line.split("=", 1))
            m = re.match(r"(xBTN|yBTN|BPIC|TYPE|DISA)(\d+)$", key)
            if m:
                buttons.setdefault(int(m.group(2)), {})[m.group(1)] = val
            else:
                info[key] = val
    return buttons, info


def parse_lang(path):
    texts = {}
    try:
        with open(path, encoding="latin-1") as f:
            for line in f:
                m = re.match(r"TXT(\d+)=(.*)", line.strip())
                if m:
                    texts[int(m.group(1))] = m.group(2).strip()
    except OSError:
        pass
    return texts


def find_skin(explicit=None):
    for d in ([explicit] if explicit else SKIN_DIRS):
        if d and os.path.isfile(os.path.join(d, "script.txt")):
            return d
    return None


def import_skin(src):
    data = src
    for cand in (src, os.path.join(src, "data")):
        if os.path.isfile(os.path.join(cand, "script.txt")):
            data = cand
            break
    else:
        sys.exit("no script.txt found in %s or %s/data" % (src, src))
    dst = SKIN_DIRS[0]
    os.makedirs(dst, exist_ok=True)
    for name in os.listdir(data):
        if name.lower().endswith((".png", ".txt")):
            shutil.copy2(os.path.join(data, name), dst)
    print("skin imported to", dst)


