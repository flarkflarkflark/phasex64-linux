# ALSA access through amixer

def find_card():
    try:
        with open("/proc/asound/cards") as f:
            for line in f:
                m = re.match(r"\s*(\d+)\s+\[(\S+)\s*\]:\s*(\S+)", line)
                if m and m.group(3) == "PhaseX64":
                    return m.group(1)
    except OSError:
        pass
    return None


class MidiMonitor:
    """Owned line-oriented `aseqdump` monitor for the PHASE ALSA-seq port.

    Port discovery is repeated only while the monitor window is open, so
    card/client renumbering and disconnect/reconnect need no fixed ALSA-seq
    address. This lifecycle deliberately knows nothing about PCM stream state.
    """
    def __init__(self):
        self.events = queue.Queue(maxsize=MIDI_EVENT_QUEUE_SIZE)
        self._lock = threading.Lock()
        self._proc = None
        self._thread = None
        self._port = None
        self._status = "closed"
        self._closed = False

    def _discover(self):
        try:
            result = subprocess.run(["aseqdump", "-l"], capture_output=True,
                                    text=True, timeout=2.0)
        except (OSError, subprocess.TimeoutExpired):
            return None, "unavailable"
        if result.returncode:
            return None, "unavailable"
        port = parse_phase_seq_port(result.stdout)
        return (port, "connected") if port else (None, "disconnected")

    def _put_event(self, line):
        line = line.strip()[:240]
        if not line:
            return
        try:
            self.events.put_nowait(line)
        except queue.Full:
            # Preserve the newest activity under a flood. Dropping and adding
            # are individual thread-safe Queue operations; a simultaneous UI
            # drain can simply make the retry unnecessary.
            try:
                self.events.get_nowait()
            except queue.Empty:
                pass
            try:
                self.events.put_nowait(line)
            except queue.Full:
                pass

    def _read(self, proc):
        returncode = None
        # Buffered line for a "System exclusive" event that might still be
        # getting hex-byte continuation lines appended (see
        # _MIDI_HEX_CONTINUATION_RE's own comment) - most likely aseqdump
        # already puts the whole dump on one line and a wrapped terminal
        # was the only thing splitting it, but this handles genuine
        # multi-line output too rather than assuming either way.
        pending = None
        try:
            for line in proc.stdout:
                if re.match(r"^\s*\d+:\d+\s+", line):
                    # A new real event line always ends whatever SysEx was
                    # being accumulated, even if that SysEx never got any
                    # continuation lines at all (the common case).
                    if pending is not None:
                        self._put_event(pending)
                        pending = None
                    formatted = format_midi_event_line(line)
                    if "System exclusive" in formatted:
                        pending = formatted
                    else:
                        self._put_event(formatted)
                elif pending is not None and _MIDI_HEX_CONTINUATION_RE.match(line):
                    if len(pending) < _MIDI_PENDING_MAX_LEN:
                        pending = pending + " " + line.strip()
                # Anything else (banner, announce, subscription-error
                # lines) does not start a new event and is not a
                # continuation of one - never put in the user's MIDI
                # history.
            returncode = proc.wait()
        except (OSError, ValueError):
            returncode = proc.poll()
        finally:
            if pending is not None:
                self._put_event(pending)
            if proc.stdout:
                proc.stdout.close()
        with self._lock:
            if self._proc is proc:
                self._proc = None
                self._thread = None
                self._port = None
                self._status = "unavailable" if returncode not in (0, None) else "disconnected"

    @staticmethod
    def _interrupt(proc):
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

    def _stop(self, status):
        with self._lock:
            proc, thread = self._proc, self._thread
            # Detach first: the reader's exit must not overwrite the status
            # selected by discovery (or by close()).
            self._proc = self._thread = self._port = None
            self._status = status
        if proc is not None:
            self._interrupt(proc)
        if thread is not None and thread is not threading.current_thread():
            thread.join(timeout=2.0)

    def ensure(self):
        port, status = self._discover()
        with self._lock:
            if self._closed:
                return self._status
            proc, current_port = self._proc, self._port
            running = proc is not None and proc.poll() is None
            if running and port == current_port:
                self._status = "connected"
                return self._status
        if running or proc is not None:
            self._stop(status)
        if port is None:
            with self._lock:
                self._status = status
            return status
        try:
            proc = subprocess.Popen(
                _with_pdeathsig(["stdbuf", "-oL", "aseqdump", "-p", port]),
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError:
            with self._lock:
                self._status = "unavailable"
            return "unavailable"
        thread = threading.Thread(target=self._read, args=(proc,), daemon=True,
                                  name="phasex64-midi-monitor")
        with self._lock:
            if self._closed:
                closed = True
            else:
                closed = False
                self._proc, self._thread = proc, thread
                self._port, self._status = port, "connected"
        if closed:
            self._interrupt(proc)
            return self._status
        thread.start()
        return "connected"

    def status(self):
        with self._lock:
            return self._status

    def stop(self):
        """Stop and reap the child but keep this monitor reusable."""
        self._stop("closed")

    def close(self):
        with self._lock:
            self._closed = True
        self._stop("closed")


class FakeMidiMonitor:
    """Offline counterpart used by --demo/--fake-mixer and GUI tests."""
    def __init__(self):
        self.events = queue.Queue(maxsize=MIDI_EVENT_QUEUE_SIZE)
        self.running = False
        self.starts = 0
        self.stops = 0

    def ensure(self):
        if not self.running:
            self.running = True
            self.starts += 1
        return "demo"

    def status(self):
        return "demo" if self.running else "closed"

    def stop(self):
        if self.running:
            self.running = False
            self.stops += 1

    def close(self):
        self.stop()


# PipeWire buffer size ("quantum", in samples). 0 = Auto (no forced value).
# Values below 64 are deliberately not offered.
BUFFER_CHOICES = (0, 64, 128, 256, 512, 1024, 2048)
BUFFER_FALLBACK_RATE = 48000
BUFFER_CONF_NAME = "20-phasex64-buffer.conf"
# Fixed label width (so the row doesn't shift as the value changes): fits the
# longest text, "auto: 2048 · 46.4 ms" (44.1 kHz).
BUFFER_LABEL_CHARS = 20
PW_METADATA_TIMEOUT = 2.0
# pw-top is the only source of the *running* quantum (its profiler view);
# bound it tightly and back off after a failure, since it shares the
# PanelIO worker with the 50ms meter poll.
PW_TOP_TIMEOUT = 1.0
PW_TOP_BACKOFF = 10.0
_PW_SETTING_RE = re.compile(r"^update: id:0 key:'([^']*)' value:'([^']*)'")
_BUFFER_CONF_RE = re.compile(r"^\s*default\.clock\.quantum\s*=\s*(\d+)\s*$", re.M)


def _to_int(text, default=None):
    try:
        return int(text)
    except (TypeError, ValueError):
        return default


def parse_pw_settings(text):
    """`pw-metadata -n settings` output -> {key: value} for subject id 0."""
    settings = {}
    for line in text.splitlines():
        match = _PW_SETTING_RE.match(line.strip())
        if match:
            settings[match.group(1)] = match.group(2)
    return settings


def parse_pw_top_quantum(text):
    """(quantum, rate) of the running graph from `pw-top -b -n 2` output,
    or None. Uses the last sample block (the first one is always zeros),
    driver lines only (followers are marked " + "), preferring the PHASE
    X64's own driver node. Any unexpected layout -> None, never a guess.
    """
    blocks, current = [], None
    for line in text.splitlines():
        tokens = line.split()
        if tokens[:4] == ["S", "ID", "QUANT", "RATE"]:
            current = []
            blocks.append(current)
        elif current is not None and tokens:
            current.append(line)
    if not blocks:
        return None
    candidates = []
    for line in blocks[-1]:
        tokens = line.split()
        if len(tokens) < 10 or re.search(r"\s\+\s", line):
            continue
        quantum, rate = _to_int(tokens[2]), _to_int(tokens[3])
        if quantum and rate:
            candidates.append(("phase_x64" in line.lower(), quantum, rate))
    if not candidates:
        return None
    _phase, quantum, rate = max(candidates, key=lambda c: c[0])
    return quantum, rate


def format_buffer_latency(quantum, rate):
    """"64 · 1.3 ms" - one period at `rate` (48 kHz if unknown)."""
    rate = rate or BUFFER_FALLBACK_RATE
    return "{quantum} · {ms:.1f} ms".format(quantum=quantum, ms=quantum * 1000 / rate)


def buffer_conf_text(quantum, min_quantum=None):
    """pipewire.conf.d drop-in making `quantum` PipeWire's default; also
    lowers default.clock.min-quantum when it would otherwise be above it.
    """
    lines = [
        "# Written by phasex64-panel (\"Keep after restart\"). Untick the option",
        "# in the panel, or delete this file, to go back to PipeWire's default.",
        "context.properties = {",
        f"    default.clock.quantum = {quantum}",
    ]
    if min_quantum is not None and min_quantum > quantum:
        lines.append(f"    default.clock.min-quantum = {quantum}")
    lines.append("}")
    return "\n".join(lines) + "\n"


class PipeWireBuffer:
    """Reads and sets PipeWire's graph quantum through pw-metadata/pw-top.
    Every method may block on a subprocess: call them from PanelIO's
    worker, never from the Tk thread.
    """

    def __init__(self, conf_dir=None):
        self.conf_dir = Path(conf_dir) if conf_dir else Path(
            os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))) / "pipewire" / "pipewire.conf.d"
        self._top_retry_at = 0.0

    @property
    def conf_path(self):
        return self.conf_dir / BUFFER_CONF_NAME

    @staticmethod
    def _run(args, timeout):
        tool = shutil.which(args[0])
        if tool is None:
            return None
        try:
            return subprocess.run([tool] + list(args[1:]), capture_output=True, text=True,
                                  timeout=timeout, env=dict(os.environ, LC_ALL="C"))
        except (OSError, subprocess.TimeoutExpired):
            return None

    def running_quantum(self):
        if time.monotonic() < self._top_retry_at:
            return None
        result = self._run(["pw-top", "-b", "-n", "2"], PW_TOP_TIMEOUT)
        if result is None or result.returncode != 0:
            self._top_retry_at = time.monotonic() + PW_TOP_BACKOFF
            return None
        return parse_pw_top_quantum(result.stdout)

    def persisted(self):
        try:
            text = self.conf_path.read_text(encoding="utf-8")
        except OSError:
            return None
        match = _BUFFER_CONF_RE.search(text)
        return int(match.group(1)) if match else None

    def state(self):
        result = self._run(["pw-metadata", "-n", "settings"], PW_METADATA_TIMEOUT)
        settings = parse_pw_settings(result.stdout) if result is not None and result.returncode == 0 else {}
        if "clock.force-quantum" not in settings:
            return {"available": False, "persisted": self.persisted()}
        forced = _to_int(settings.get("clock.force-quantum"), 0)
        return {
            "available": True,
            "forced": forced,
            "running": self.running_quantum() if forced == 0 else None,
            "rate": _to_int(settings.get("clock.rate")),
            "min": _to_int(settings.get("clock.min-quantum")),
            "persisted": self.persisted(),
        }

    @staticmethod
    def apply_command(quantum):
        if quantum not in BUFFER_CHOICES:
            raise ValueError(_("Unsupported buffer size: {size}").format(size=quantum))
        return ["pw-metadata", "-n", "settings", "0", "clock.force-quantum", str(quantum)]

    def apply(self, quantum):
        result = self._run(self.apply_command(quantum), PW_METADATA_TIMEOUT)
        if result is None:
            raise RuntimeError(_("pw-metadata is not available"))
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or "pw-metadata exit {code}".format(code=result.returncode))
        return quantum

    def persist(self, quantum, min_quantum=None):
        """Write the drop-in for `quantum`, or remove it for None/0 (Auto).
        Only ever touches this panel's own file."""
        path = self.conf_path
        if not quantum:
            path.unlink(missing_ok=True)
            return None
        if quantum not in BUFFER_CHOICES:
            raise ValueError(_("Unsupported buffer size: {size}").format(size=quantum))
        self.conf_dir.mkdir(parents=True, exist_ok=True)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.conf_dir,
                                             prefix=".phasex64-buffer-", delete=False) as stream:
                temporary = Path(stream.name)
                stream.write(buffer_conf_text(quantum, min_quantum))
            os.replace(temporary, path)
            temporary = None
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
        return quantum


class FakePipeWireBuffer:
    """In-memory counterpart for --demo/--fake-mixer and GUI tests: never
    runs pw-metadata, so a demo can't change the real PipeWire graph."""

    def __init__(self, available=True):
        self.available = available
        self.forced = 0
        self.running = (1024, 48000)
        self.rate = 48000
        self.min = 32
        self.kept = None
        self.applied = []

    def state(self):
        if not self.available:
            return {"available": False, "persisted": self.kept}
        return {"available": True, "forced": self.forced,
                "running": self.running if self.forced == 0 else None,
                "rate": self.rate, "min": self.min, "persisted": self.kept}

    def apply(self, quantum):
        PipeWireBuffer.apply_command(quantum)
        self.forced = quantum
        self.applied.append(quantum)
        return quantum

    def persist(self, quantum, min_quantum=None):
        self.kept = quantum or None
        return self.kept


class Mixer:
    def __init__(self, card):
        self.card = card
        self.available = set()
        self.cancel = threading.Event()
        self._monitor_lock = threading.Lock()
        self._monitor_stop = threading.Event()
        self._monitor_proc = None
        self._monitor_thread = None
        self.midi_monitor = MidiMonitor()
        self.buffer = PipeWireBuffer()

    def contents(self):
        if self.card is None:
            self.available = set()
            return {}
        # Never use `contents`: it would consume reset-on-read peak controls
        # during slow status refreshes, even when the window is hidden.
        out = self._run(["controls"])
        self.available = set(re.findall(r"name='([^']*)'", out))
        return self._read_names(name for name in STATE_NAMES if name in self.available)

    def _run(self, arguments, input_text=None):
        try:
            result = subprocess.run(["amixer", "-c", str(self.card)] + arguments,
                                    input=input_text, capture_output=True, text=True,
                                    timeout=2.0)
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise RuntimeError(_("ALSA control access unavailable")) from exc
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or _("ALSA control request failed"))
        return result.stdout

    def _read_names(self, names):
        # amixer --stdin implements writes, not cget. Read each named element
        # explicitly; discovery/status never reads or resets any peak element.
        values = {}
        for name in names:
            if self.cancel.is_set():
                break
            values.update(parse_values(self._run(["cget", "name=" + name])))
        return values

    def peaks(self, visible=None):
        names = [name for name in PEAK_NAMES if name in self.available]
        peaks = {}
        for name in names:
            if self.cancel.is_set() or (visible is not None and not visible.is_set()):
                break
            peaks[name] = parse_peak(self._read_names([name]).get(name))
        return peaks

    def set(self, name, value):
        if name not in STATE_NAMES or name not in self.available:
            raise ValueError(_("Control unavailable: {name}").format(name=name))
        self._run(["-q", "cset", "name=" + name, str(value)])

    def rate(self):
        path = "/proc/asound/card%s/pcm0p/sub0/hw_params" % self.card
        for p in (path, path.replace("pcm0p", "pcm0c")):
            try:
                with open(p) as f:
                    m = re.search(r"rate:\s*(\d+)", f.read())
                    if m:
                        return int(m.group(1))
            except OSError:
                pass
        return None

    def stream_active(self):
        states = []
        for direction in ("p", "c"):
            try:
                text = Path(f"/proc/asound/card{self.card}/pcm0{direction}/sub0/status").read_text()
            except OSError:
                continue
            if text.strip() == "closed":
                states.append(False)
            else:
                match = re.search(r"state:\s*(\w+)", text)
                if match:
                    states.append(match.group(1) in ("RUNNING", "DRAINING"))
        return any(states) if states else None

    def midi_counters(self):
        """Return aggregate (Rx, Tx) rawmidi byte counters for this card."""
        if self.card is None:
            return None, None
        rx_total = tx_total = 0
        rx_found = tx_found = False
        try:
            paths = sorted(Path(PROC_ASOUND, f"card{self.card}").glob("midi[0-9]*"))
        except OSError:
            return None, None
        for path in paths:
            try:
                rx, tx = parse_midi_counters(path.read_text(encoding="ascii"))
            except (OSError, UnicodeDecodeError):
                continue
            if rx is not None:
                rx_total += rx
                rx_found = True
            if tx is not None:
                tx_total += tx
                tx_found = True
        return rx_total if rx_found else None, tx_total if tx_found else None

    def midi_available(self):
        """True iff the PHASE rawmidi device is registered (ALSA card
        loaded, its MIDI device present under /proc/asound) - independent
        of whether anything has ever opened it, and *not* the monitor
        window's own aseqdump subprocess state (that's a separate, much
        rarer action - see MidiMonitor.status() for that). Checking the
        rawmidi proc entry rather than the ALSA-seq port (`aseqdump -l`)
        here specifically: this runs every ~1s on the ordinary state
        poll, and a plain /proc read is free at that cadence where
        spawning a subprocess every second would not be - the seq port's
        own presence is still checked thoroughly, just only when the
        monitor window is actually opened, a deliberate, infrequent
        action rather than this continuous background poll.
        """
        if self.card is None:
            return None
        try:
            return bool(list(Path(PROC_ASOUND, f"card{self.card}").glob("midi[0-9]*")))
        except OSError:
            return None

    def start_change_monitor(self, on_change):
        """Run `alsactl monitor <card>` in the background and call
        on_change() (from a worker thread) whenever it prints a line, so
        the panel follows changes made elsewhere (amixer, alsamixer, the
        Windows-style skin in another window). Any line is treated as
        "something changed, go re-read everything" - we don't parse which
        control, refresh() already does a full re-read. Best effort: if
        alsactl isn't available or exits, the caller's periodic poll is
        the fallback, so failures here are silently ignored.
        """
        self.stop_change_monitor()
        self._monitor_stop.clear()
        try:
            proc = subprocess.Popen(
                _with_pdeathsig(["alsactl", "monitor", "hw:%s" % self.card]),
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None

        def run():
            try:
                for _line in proc.stdout:
                    if self._monitor_stop.is_set():
                        break
                    on_change()
            finally:
                # If the callback failed, do not leave the child blocked in
                # alsactl after its only reader disappeared.
                if proc.poll() is None:
                    proc.terminate()
                try:
                    proc.wait(timeout=1.0)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                if proc.stdout:
                    proc.stdout.close()
                with self._monitor_lock:
                    if self._monitor_proc is proc:
                        self._monitor_proc = None
                        self._monitor_thread = None

        thread = threading.Thread(target=run, daemon=True,
                                  name="phasex64-alsactl-monitor")
        with self._monitor_lock:
            self._monitor_proc = proc
            self._monitor_thread = thread
        thread.start()
        return thread

    def stop_change_monitor(self):
        """Terminate and reap only the monitor child started by this mixer."""
        self._monitor_stop.set()
        with self._monitor_lock:
            proc = self._monitor_proc
            thread = self._monitor_thread
        if proc is not None:
            if proc.poll() is None:
                proc.terminate()
            try:
                proc.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        if thread is not None and thread is not threading.current_thread():
            thread.join(timeout=2.0)
        with self._monitor_lock:
            if self._monitor_proc is proc:
                self._monitor_proc = None
            if self._monitor_thread is thread:
                self._monitor_thread = None

    def ensure_change_monitor(self, on_change):
        """Keep monitoring the currently enumerated PHASE X64 card.

        A driver/device reload can end alsactl and can assign a different card
        number. The panel's one-second refresh calls this method, which leaves
        a healthy child alone and otherwise restarts one for the new card.
        """
        card = find_card()
        with self._monitor_lock:
            proc = self._monitor_proc
            thread = self._monitor_thread
        running = proc is not None and proc.poll() is None
        if card is None:
            if running:
                self.stop_change_monitor()
            self.card = None
            self.available = set()
            return None
        if running and card == self.card:
            return thread
        self.card = card
        self.available = set()
        return self.start_change_monitor(on_change)


class FakeMixer:
    """In-memory mixer for testing the panel without hardware or a loaded
    driver - mirrors the ALSA control set and the mono-direct interlock
    closely enough to exercise the panel's click()/refresh() logic.
    `phasex64-panel --fake-mixer [--plain]`.
    """

    def __init__(self, demo=False):
        self.values = {
            "In 1/2 Capture Source": "0",
            "In 3/4 Capture Source": "1",
            "Direct 1/2 Playback Switch": "off",
            "Direct 1/2 Mono Playback Switch": "off",
            "PCM 1/2 Playback Switch": "on",
            "PCM 1/2 Mono Playback Switch": "off",
            "Direct 3/4 Playback Switch": "off",
            "Sound Module 3/4 Playback Switch": "off",
            "PCM 3/4 Playback Switch": "on",
            "PCM 3/4 Mono Playback Switch": "off",
            CLOCK: "0",
            LOCK: "off",
            "Digital Input Rate": "48000",
        }
        self.values.update({name: "on" for name in RIAA_NAMES})
        self._rate = 48000
        self.card = "fake"
        self.on_change = None
        self.demo = demo
        self.signal = False
        self.meters_present = demo
        self.available = set(self.values) | (set(PEAK_NAMES) if demo else set())
        self.midi_rx = self.midi_tx = 0
        self.midi_monitor = FakeMidiMonitor()
        self.buffer = FakePipeWireBuffer()
        if demo:
            self.values["In 1/2 Capture Source"] = "1"

    def contents(self):
        return dict(self.values)

    def set(self, name, value):
        if name not in self.values:
            return
        self.values[name] = value
        self._apply_mono_interlock()
        if self.on_change:
            self.on_change()

    def _apply_mono_interlock(self):
        """Same rule as px_switch_put()/px_adc_source_put(): mono-direct
        needs the mic input and direct monitoring."""
        mic = self.values["In 1/2 Capture Source"] == "0"
        direct = self.values["Direct 1/2 Playback Switch"] == "on"
        if self.values["Direct 1/2 Mono Playback Switch"] == "on" and not (mic and direct):
            self.values["Direct 1/2 Mono Playback Switch"] = "off"

    def rate(self):
        return self._rate

    def stream_active(self):
        return self.signal

    def midi_counters(self):
        return self.midi_rx, self.midi_tx

    def midi_available(self):
        return True

    def peaks(self, visible=None):
        if not self.meters_present:
            return {}
        t = time.monotonic()
        return {name: tuple(int(PEAK_MAX * 10 ** ((-13 + 9 * math.sin(t * 2.8 + i + ch * .4)) / 20))
                            if self.signal else 0 for ch in range(2))
                for i, name in enumerate(PEAK_NAMES)}

    def start_change_monitor(self, on_change):
        # No external process to watch for a fake mixer; external test
        # code can drive changes via .set() directly, which already
        # calls on_change() synchronously above.
        self.on_change = on_change
        return None

    def stop_change_monitor(self):
        self.on_change = None

    def ensure_change_monitor(self, on_change):
        return None


