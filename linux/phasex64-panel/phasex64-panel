def parse_values(output):
    values, name = {}, None
    for line in output.splitlines():
        match = re.search(r"name='([^']*)'", line)
        if match:
            name = match.group(1)
        match = re.match(r"\s*: values=(.*)", line)
        if match and name:
            values[name], name = match.group(1).strip(), None
    return values


def parse_peak(value):
    try:
        pair = tuple(int(part.strip()) for part in value.split(","))
        return pair if len(pair) == 2 and all(0 <= x <= PEAK_MAX for x in pair) else None
    except (ValueError, AttributeError):
        return None


def parse_midi_counters(output):
    """Return (Rx bytes, Tx bytes) from one ALSA rawmidi proc file.

    The file contains separate Input/Output sections, but the labels are
    unique and stable enough that no section parser is needed. A missing
    direction stays None rather than looking like a zero-byte counter.
    """
    values = {}
    for direction in ("Rx", "Tx"):
        match = re.search(rf"^\s*{direction}\s+bytes\s*:\s*(\d+)\s*$",
                          output, re.MULTILINE)
        if match:
            values[direction] = int(match.group(1))
    return values.get("Rx"), values.get("Tx")


def parse_phase_seq_port(output):
    """Resolve the current PHASE ALSA-seq input port from `aseqdump -l`."""
    for line in output.splitlines():
        match = re.match(r"^\s*(\d+:\d+)\s+(.+)$", line)
        if match and re.search(r"\bPHASE\s+X64\b", match.group(2), re.IGNORECASE):
            return match.group(1)
    return None


# Addendum (2026-10-19): the LAST run of 2+ spaces on a line separates
# aseqdump's fixed 32-char-padded event-name field from its free-form data
# (format strings confirmed via `strings aseqdump`:
# "%3d:%-3d  %-32.32s %s\n", event names under 25 chars so always padded
# with several trailing spaces) - a robust anchor without needing to
# byte-count the variable-width "%3d:%-3d" source field at the start.
_MIDI_LAST_GAP_RE = re.compile(r"  +")
# Channel-voice events (Note on/off, Control change, Program change,
# Channel/Poly aftertouch, Pitch bend, ...) all start their data with the
# 0-based channel number then a comma (same format strings) - events with
# no channel (Clock, Start, Stop, System exclusive, Song position
# pointer, ...) don't match this shape and pass through unchanged, by
# construction, not by enumerating every event name.
_MIDI_CHANNEL_PREFIX_RE = re.compile(r"^(\d+)(,.*)$")


def format_midi_event_line(line):
    """Reformat one raw `aseqdump` event line for display: channels shown
    as 1-16, matching MIDI convention - aseqdump's own -R/--raw-view
    default (unchanged by this panel) prints 0-15. Best-effort by
    construction (see the regexes above), not a byte-exact grammar - this
    project cannot run aseqdump against the real port to verify the exact
    column widths for every aseqdump version, so it degrades to passing
    the line through unchanged rather than risk corrupting anything it
    doesn't confidently recognise.
    """
    line = line.rstrip("\n")
    last = None
    for last in _MIDI_LAST_GAP_RE.finditer(line):
        pass
    if last is None:
        return line
    data = line[last.end():]
    match = _MIDI_CHANNEL_PREFIX_RE.match(data)
    if not match:
        return line
    channel, rest = match.groups()
    return line[:last.end()] + str(int(channel) + 1) + rest


# Addendum (2026-10-19): Clock/Active Sensing are pure heartbeat messages
# with no information content for a human reading the monitor - a steady
# 120 BPM clock alone is 48 lines/second (confirmed on hardware, exactly
# 480 clocks in 10s - see analysis/NOTES.md). Filtered out by default,
# with a toggle to show them; matched by event name, not by position, so
# it stays correct regardless of channel/data formatting changes above.
_MIDI_CLOCK_EVENT_RE = re.compile(r"^\s*\d+:\d+\s+(Clock|Active Sensing)\b")

# Addendum (2026-10-19, hardware test): ALSA-seq client 0 is always the
# kernel's own System Timer/Announce client (confirmed in this project's
# own `aseqdump -l` listing - "0:0 System Timer", "0:1 System Announce" -
# a stable ALSA convention, not specific to this device) - events from it
# (confirmed on hardware: "Port subscribed", other clients' own connect/
# disconnect traffic) are ALSA sequencer *graph* meta-events, not MIDI
# performance data at all - a different kind of noise from Clock/Active
# Sensing above, filtered by a *separate* toggle rather than folded into
# that one: someone debugging "why won't anything connect to this port"
# wants exactly these without a 48 msg/s clock flood, and someone
# debugging clock timing wants the opposite - combining the two toggles
# would force either person to see noise they didn't ask for. Matched by
# source client number, not by event name, since "client 0" is the
# stable invariant here, not any particular event name list.
_MIDI_SYSTEM_EVENT_RE = re.compile(r"^\s*0:\d+\s+")


# A continuation line of a multi-line SysEx dump is just hex byte pairs
# (aseqdump's own "%s%02x"/" %02X" format strings) - no source address
# prefix, unlike every real event line.
_MIDI_HEX_CONTINUATION_RE = re.compile(r"^\s*(?:[0-9A-Fa-f]{2}\s*)+$")
_MIDI_PENDING_MAX_LEN = 2000


def peak_db(value):
    return max(-60.0, 20 * math.log10(value / PEAK_MAX)) if value > 0 else -60.0


