    def _finish_midi_monitor_close(self):
        window = self.midi_window
        self.midi_window = None
        self.midi_monitor_widget = None
        self.midi_monitor_state = None
        self.midi_stream_hint = None
        self.midi_show_clock_var = None
        self.midi_show_system_var = None
        self.midi_monitor_lines = []
        self.midi_monitor_status = "closed"
        self.midi_monitor_closing = False
        self.pending_midi_monitor = False
